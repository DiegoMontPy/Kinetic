---
import "../styles/tokens.css";
import "../styles/global.css";

import { getImage } from "astro:assets";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { car } from "../data/car";
import { site, ui } from "../data/site";
import { findAsset } from "../lib/assets";
import { withBase } from "../lib/paths";
import revealScript from "../lib/reveal.js?raw";

interface Props {
  title: string;
  description: string;
  /** For pages without an address of their own, such as the 404: kept out of search and canonical. */
  noindex?: boolean;
  /** False on pages that already end with the sponsor wall, right above the footer. */
  footerSponsors?: boolean;
}

const { title, description, noindex = false, footerSponsors = true } = Astro.props;
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site);

// The side view keeps the whole chassis inside the 1.91:1 crop social networks use.
const socialImage = car.images.side;
const socialSource = findAsset(socialImage.file) ?? findAsset(car.images.wireframe.file);
const ogImage = socialSource
  ? await getImage({
      src: socialSource,
      width: 1200,
      height: 630,
      fit: "cover",
      format: "jpeg",
      background: site.themeColor,
    })
  : undefined;
const ogImageUrl = ogImage && new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <link
      rel="preload"
      href={withBase("/fonts/lexend-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/albert-sans-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content={String(ogImage.attributes.width)} />
        <meta property="og:image:height" content={String(ogImage.attributes.height)} />
        <meta property="og:image:alt" content={socialImage.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImageUrl} />}

    <script is:inline set:html={revealScript} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui.skipToContent}
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter sponsors={footerSponsors} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
