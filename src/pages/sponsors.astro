---
import SponsorIntro from "../components/SponsorIntro.astro";
import SponsorLevels from "../components/SponsorLevels.astro";
import SponsorWall from "../components/SponsorWall.astro";
import { pages } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = pages.sponsors;
---

<BaseLayout title={page.title} description={page.description} footerSponsors={false}>
  <SponsorIntro />
  <SponsorLevels />
  <!-- Same wall and contact band as Inicio: it is the same content. -->
  <SponsorWall />
</BaseLayout>
