---
import { Image } from "astro:assets";

import { placeholderLabels } from "../data/site";
import type { Sponsor } from "../data/sponsors";
import { findAsset } from "../lib/assets";
import Placeholder from "./Placeholder.astro";

interface Props {
  sponsor: Sponsor;
  /** Rendered width of the logo at each breakpoint, as in the `sizes` attribute. */
  sizes?: string;
}

const { sponsor, sizes = "(max-width: 639px) 40vw, 180px" } = Astro.props;
const logo = findAsset(`sponsors/${sponsor.logo}`);
const Plate = sponsor.url ? "a" : "div";
---

{logo ? (
  <Plate
    class="plate"
    href={sponsor.url}
    data-plate={sponsor.plate}
    data-transparent={sponsor.transparent || undefined}
  >
    <Image
      src={logo}
      alt={sponsor.name}
      width={480}
      widths={[160, 320, 480]}
      sizes={sizes}
      format={sponsor.logo.endsWith(".svg") ? "svg" : "webp"}
    />
  </Plate>
) : (
  <Placeholder
    ratio="1:1"
    label={placeholderLabels.sponsorLogo}
    icon="badge"
    description={sponsor.name}
  />
)}

<style>
  /* Square on the wall; the rows of logos set --plate-ratio and --plate-padding for a wide plate. */
  .plate {
    display: grid;
    place-items: center;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    aspect-ratio: var(--plate-ratio, 1);
    min-height: 0;
    padding: var(--plate-padding, var(--plate-inset));
    border-radius: var(--radius-control);
    background: var(--color-plate);
    isolation: isolate;
  }

  /* The logo fits the plate and never stretches it, whatever its proportions. It always shows in its
     own colors, at full opacity. Multiply turns a white logo background into the plate color. */
  .plate :global(img) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Dark plate for logos that come in white: screen turns their black background into the plate. */
  .plate[data-plate="dark"] {
    background: var(--color-plate-dark);
  }

  .plate[data-plate="dark"] :global(img) {
    mix-blend-mode: screen;
  }

  /* A logo without a background has nothing to blend: it keeps its exact colors on either plate. */
  .plate[data-transparent] :global(img) {
    mix-blend-mode: normal;
  }
</style>
