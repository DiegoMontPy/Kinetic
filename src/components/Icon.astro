---
import type { HTMLAttributes } from "astro/types";

const paths = {
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6 6 18",
  plus: "M12 5v14M5 12h14",
  chevron: "m6 9 6 6 6-6",
  download: "M12 4v11m-5-5 5 5 5-5M5 20h14",
  render: "M12 3 20 7.5v9L12 21l-8-4.5v-9L12 3Zm-8 4.5 8 4.5 8-4.5M12 12v9",
  camera: "M4 8h3l2-3h6l2 3h3v11H4V8Zm8 8.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z",
  person: "M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-7 9c1-3.5 3.8-5.5 7-5.5s6 2 7 5.5",
  badge: "M12 3 19 6v6c0 4.2-2.9 7.3-7 9-4.1-1.7-7-4.8-7-9V6l7-3Z",
  tbd: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-2.5-11.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5v.7m0 3h.01",
  instagram:
    "M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm5.5-9.5h.01",
};

interface Props extends HTMLAttributes<"svg"> {
  name: keyof typeof paths;
  size?: "sm" | "md" | "lg";
}

const { name, size = "md", class: className, ...attrs } = Astro.props;
---

<svg
  class:list={["icon", className]}
  data-size={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  {...attrs}
>
  <path d={paths[name]}></path>
</svg>

<style>
  .icon {
    flex: none;
    width: var(--icon-md);
    height: var(--icon-md);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon[data-size="sm"] {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }

  .icon[data-size="lg"] {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }
</style>
