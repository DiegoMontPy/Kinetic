---
import { media } from "../data/media";
import { home } from "../data/site";
import PhotoFigure from "./PhotoFigure.astro";

const { fsae } = home;
---

<section class="section" aria-labelledby="fsae-title">
  <div class="container layout">
    <div class="intro">
      <h2 id="fsae-title">{fsae.heading}</h2>
      <p class="lede">{fsae.intro}</p>
      <p class="note">{fsae.companyNote}</p>
    </div>
    <div class="photo" data-reveal>
      <PhotoFigure
        photo={media.home.fsae}
        sizes="(min-width: 1188px) 588px, (min-width: 960px) 52vw, 100vw"
      />
    </div>
    <ol class="sequence list-reset">
      {fsae.phases.map((phase, index) => (
        <li class="phase" data-reveal>
          <span class="number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div class="body">
            <h3>{phase.title}</h3>
            <p>{phase.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: var(--space-12) var(--space-16);
  }

  /* The text stays beside the photo and then beside the phases, which run down under the photo. */
  .intro {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-10));
    grid-row: span 2;
    display: grid;
    gap: var(--space-5);
  }

  .note {
    max-width: var(--measure);
    color: var(--color-text);
  }

  .phase {
    display: grid;
    grid-template-columns: var(--space-16) minmax(0, 1fr);
    column-gap: var(--space-6);
  }

  /* The number column stretches the full height of the phase, so its line reaches the next one. */
  .number {
    display: flex;
    flex-direction: column;
    color: var(--color-line-blue);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .phase:not(:last-child) .number::after {
    content: "";
    flex: 1;
    width: var(--border-width);
    margin: var(--space-4) 0 var(--space-4) var(--space-4);
    background: var(--color-line-blue);
  }

  .body {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-bottom: var(--space-12);
  }

  .phase:last-child .body {
    padding-bottom: 0;
  }

  .body h3 {
    font-size: var(--text-xl);
  }

  .body p {
    max-width: var(--measure-narrow);
    color: var(--color-text-muted);
  }

  @media (max-width: 959px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }

    .intro {
      position: static;
      grid-row: auto;
    }
  }

  @media (max-width: 639px) {
    .phase {
      grid-template-columns: var(--space-12) minmax(0, 1fr);
      column-gap: var(--space-4);
    }
  }
</style>
