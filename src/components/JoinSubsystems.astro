---
import { media } from "../data/media";
import { joinPage } from "../data/site";
import { subsystems } from "../data/subsystems";
import KeepTogether from "./KeepTogether.astro";
import PhotoFigure from "./PhotoFigure.astro";

const copy = joinPage.subsystems;
---

<section class="section" id="subsistemas" aria-labelledby="subsystems-title">
  <div class="container">
    <div class="section-head">
      <p class="caps">{copy.eyebrow}</p>
      <h2 id="subsystems-title" class="title">
        {copy.heading}
      </h2>
      <p class="lede">
        <KeepTogether text={copy.lead} />
      </p>
    </div>
    <div class="chapters">
      {subsystems.map((subsystem) => {
        const photo = media.join.subsystems[subsystem.id];
        return (
          <article class="chapter" aria-labelledby={`subsystem-${subsystem.id}`} data-reveal>
            <h3 id={`subsystem-${subsystem.id}`} class="name">
              {subsystem.name}
            </h3>
            <p class="role">
              <KeepTogether text={subsystem.role} />
            </p>
            <div class="learn">
              <h4 class="caps" id={`subsystem-${subsystem.id}-learn`}>
                {copy.learnLabel}
              </h4>
              <ul class="learn-list list-reset" aria-labelledby={`subsystem-${subsystem.id}-learn`}>
                {subsystem.learn.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <p class="fit">
              <strong>{copy.fitLabel}</strong> {subsystem.fit}
            </p>
            {photo && (
              <div class="photo">
                <PhotoFigure
                  photo={photo}
                  sizes="(min-width: 1188px) 442px, (min-width: 960px) 37vw, 100vw"
                />
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .chapters {
    container-type: inline-size;
  }

  /* One chapter per subsystem: its name at the size of the motto on Inicio, the text beside its photo. */
  .chapter {
    display: grid;
    grid-template-areas:
      "name name name"
      "role role photo"
      "learn fit photo";
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 5fr);
    grid-template-rows: auto auto 1fr;
    align-items: start;
    gap: var(--space-8) var(--space-10);
    padding-block: var(--space-12) var(--space-16);
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .chapter:last-child {
    padding-bottom: 0;
  }

  /* Never wider than the column, so the longest name ("Manufactura") fits on the narrowest phone. */
  .name {
    grid-area: name;
    font-size: min(var(--text-display), var(--chapter-name-fit));
    font-weight: var(--weight-bold);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .role {
    grid-area: role;
    max-width: var(--measure-narrow);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .learn {
    grid-area: learn;
    display: grid;
    gap: var(--space-3);
  }

  .learn h4 {
    margin: 0;
  }

  .learn-list li {
    padding-block: var(--space-2);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
  }

  .fit {
    grid-area: fit;
    color: var(--color-text-muted);
  }

  .fit strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .photo {
    grid-area: photo;
  }

  @media (max-width: 959px) {
    .chapter {
      grid-template-areas:
        "name name"
        "role role"
        "photo photo"
        "learn fit";
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
    }
  }

  @media (max-width: 639px) {
    .chapter {
      grid-template-areas:
        "name"
        "role"
        "photo"
        "learn"
        "fit";
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-10);
    }
  }
</style>
