---
import { footer, navigation, site } from "../data/site";
import { withBase } from "../lib/paths";
import Brand from "./Brand.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="columns">
      <div class="identity">
        <Brand showCategory={false} />
        <p class="description">{footer.description}</p>
      </div>
      <nav aria-labelledby="footer-sections">
        <h2 class="heading" id="footer-sections">
          {footer.headings.sections}
        </h2>
        <ul class="links list-reset">
          {navigation.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="footer-participate">
        <h2 class="heading" id="footer-participate">
          {footer.headings.participate}
        </h2>
        <ul class="links list-reset">
          {footer.participateLinks.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <h2 class="heading">{footer.headings.follow}</h2>
        <ul class="links list-reset">
          <li>
            <a href={site.instagram.url} rel="me">
              {site.instagram.label}
              <span class="handle">{site.instagram.handle}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>{footer.copyright(year)}</p>
      <p class="caps" lang="en">
        {site.taglines.performance}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-16) var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .columns {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-10);
  }

  .description {
    max-width: var(--measure-narrow);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .heading {
    margin-bottom: var(--space-4);
    color: var(--color-text-subtle);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
  }

  .links {
    display: grid;
    gap: var(--space-1);
  }

  .links a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .links a:hover {
    color: var(--color-text);
  }

  .handle {
    color: var(--color-text-subtle);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .legal .caps {
    color: var(--color-text-subtle);
  }

  @media (max-width: 959px) {
    .columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .identity {
      grid-column: 1 / -1;
    }
  }
</style>
