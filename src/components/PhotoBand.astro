---
import { Picture } from "astro:assets";

import { car } from "../data/car";
import type { PhotoSlot } from "../data/media";
import { placeholderLabels } from "../data/site";
import { findAsset } from "../lib/assets";
import { findPhoto } from "../lib/media";

interface Props {
  photo: PhotoSlot;
}

const { photo } = Astro.props;
const image = findPhoto(photo);
// Until the photo exists, the band is a drawing sheet: the side view of the chassis, cropped close.
const drawing = image ? undefined : findAsset(car.images.side.file);
---

<!-- Full-width pause between two sections. -->
<figure
  class="band"
  data-empty={!image || undefined}
  style={photo.position && `--photo-position: ${photo.position}`}
>
  {image ? (
    <Picture
      src={image}
      alt={photo.alt}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[640, 960, 1440, 1920, 2560]}
      sizes="100vw"
      width={1920}
    />
  ) : (
    <div class="sheet blueprint" aria-hidden="true">
      {drawing && (
        <Picture
          src={drawing}
          alt=""
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 639px) 190vw, 130vw"
          width={1280}
        />
      )}
    </div>
  )}
  <figcaption class="caption">
    {!image && (
      <span class="status">
        {photo.label} · {placeholderLabels.pending}
      </span>
    )}
    <span class="text">{photo.caption}</span>
  </figcaption>
</figure>

<style>
  .band {
    position: relative;
    height: var(--band-height);
    border-top: var(--border-width) solid var(--color-border);
    overflow: clip;
    container-type: inline-size;
  }

  .band:not([data-empty]) :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-position, 50% 50%);
  }

  /* With a photo, the caption is a small tag in the corner, like the one under the hero render. */
  .caption {
    position: absolute;
    right: max(var(--gutter), (100cqi - var(--container)) / 2);
    bottom: var(--space-6);
    padding: var(--space-1) var(--space-2);
    background: var(--color-bg);
    font-size: var(--text-xs);
  }

  .sheet {
    --blueprint-shape: ellipse 80% 95% at 60% 50%;
    position: absolute;
    inset: 0;
  }

  /* Close on the tubes, bleeding off the right edge and fading into the grid on the left. */
  .sheet :global(img) {
    position: absolute;
    top: 50%;
    left: var(--band-drawing-left);
    width: var(--band-drawing-width);
    max-width: none;
    translate: 0 -50%;
    opacity: var(--band-drawing-dim);
    mask-image: linear-gradient(to right, transparent 10%, black 50%);
  }

  /* Without a photo, the caption becomes the title block of the sheet. */
  .band[data-empty] .caption {
    right: auto;
    bottom: var(--space-10);
    left: max(var(--gutter), (100cqi - var(--container)) / 2);
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure-narrow);
    padding: 0;
    background: none;
  }

  .status {
    white-space: nowrap;
    color: var(--color-accent-hover);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    line-height: var(--leading-snug);
    text-transform: uppercase;
  }

  .band[data-empty] .text {
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
  }

  /* Phones: the drawing fills the top of the band and fades out above the title block. */
  @media (max-width: 639px) {
    .sheet :global(img) {
      top: 0;
      left: var(--band-drawing-left-sm);
      width: var(--band-drawing-width-sm);
      translate: 0 -12%;
      mask-image: linear-gradient(to bottom, black 35%, transparent 72%);
    }

    .band[data-empty] .caption {
      bottom: var(--space-6);
    }
  }
</style>
