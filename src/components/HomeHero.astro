---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import { car } from "../data/car";
import { home, placeholderLabels, site } from "../data/site";
import { findAsset } from "../lib/assets";
import ButtonLink from "./ButtonLink.astro";
import KeepTogether from "./KeepTogether.astro";
import Placeholder from "./Placeholder.astro";

const { hero } = home;
const { render, wireframe } = car.images;

// The final render wins; the CAD wireframe stands in until it exists.
const visual = [render, wireframe]
  .map((image) => ({ alt: image.alt, src: findAsset(image.file) }))
  .find((image): image is { alt: string; src: ImageMetadata } => image.src !== undefined);
---

<section class="hero blueprint" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="caps">{hero.eyebrow}</p>
      <h1 id="hero-title" class="motto" lang="en">
        {site.motto.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="lede intro">
        <KeepTogether text={hero.intro} />
      </p>
      <div class="actions">
        <ButtonLink href={hero.primaryAction.href}>{hero.primaryAction.label}</ButtonLink>
        <ButtonLink href={hero.secondaryAction.href} variant="outline">
          {hero.secondaryAction.label}
        </ButtonLink>
      </div>
    </div>
    <figure class="visual">
      {visual ? (
        <Picture
          src={visual.src}
          alt={visual.alt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1440]}
          sizes="(min-width: 960px) 600px, calc(100vw - 48px)"
          width={960}
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <Placeholder ratio="16:9" label={placeholderLabels.render} icon="render" />
      )}
      <figcaption class="caps">{car.images.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: var(--hero-min-height);
    padding-block: var(--space-12) var(--space-16);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: var(--space-12);
  }

  .motto {
    margin-block: var(--space-5) var(--space-6);
    font-size: var(--text-display);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .motto span {
    display: block;
  }

  .intro {
    max-width: var(--measure-narrow);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .visual :global(img) {
    width: 100%;
    height: auto;
  }

  .visual figcaption {
    margin-top: var(--space-3);
    text-align: right;
  }

  @media (prefers-reduced-motion: no-preference) {
    .copy > *,
    .visual {
      animation: hero-enter var(--duration-reveal) var(--ease-out) both;
    }

    .copy > :nth-child(2),
    .visual {
      animation-delay: var(--stagger-step);
    }

    .copy > :nth-child(3) {
      animation-delay: calc(2 * var(--stagger-step));
    }

    .copy > :nth-child(4) {
      animation-delay: calc(3 * var(--stagger-step));
    }
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-shift));
    }
  }

  @media (max-width: 959px) {
    .hero {
      min-height: auto;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .visual figcaption {
      text-align: left;
    }
  }
</style>
